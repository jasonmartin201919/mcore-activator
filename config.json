<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>MCORE · 高效视觉资产管理工具</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://raw.githubusercontent.com">
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    
    <style>
        :root { --tesla-black: #171a20; --tesla-gray: #393c41; --mcore-blue: #3e6ae1; }
        
        body { 
            background-color: #fff; 
            color: var(--tesla-black); 
            font-family: 'Inter', "PingFang SC", "Microsoft YaHei", sans-serif; 
            -webkit-font-smoothing: antialiased; 
            scroll-behavior: smooth;
            overflow-x: hidden;
        }

        /* 顶部导航 */
        nav { 
            position: fixed; top: 0; width: 100%; height: 56px; 
            display: flex; align-items: center; justify-content: space-between; 
            padding: 0 24px; z-index: 1000; 
            background: rgba(255,255,255,0.8);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
        .nav-links a { 
            padding: 8px 16px; font-size: 14px; font-weight: 600; 
            color: var(--tesla-black); border-radius: 4px; transition: 0.3s;
        }
        .nav-links a:hover { background: rgba(0,0,0,0.05); }

        #menuBtn { cursor: pointer; padding: 8px; z-index: 1100; }
        .brand-container { display: flex; align-items: center; }
        .brand-logo { height: 28px; width: auto; object-fit: contain; }

        /* 轮播区域高度优化：避免审核判定内容过少 */
        .hero-slider { position: relative; height: 80vh; min-height: 500px; width: 100%; overflow: hidden; background: #000; }
        .slide { 
            position: absolute; inset: 0; opacity: 0; transition: opacity 0.8s ease; 
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            text-align: center;
        }
        .slide.active { opacity: 1; }
        .slide-overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.4); z-index: 1; }
        .slide-content { z-index: 10; color: white; padding: 0 20px; }
        .slide-content h1 { font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem; }

        .slider-ctrl { 
            position: absolute; top: 50%; transform: translateY(-50%); z-index: 50; 
            color: white; width: 50px; height: 50px; display: flex; align-items: center; 
            justify-content: center; cursor: pointer; opacity: 0.5; transition: 0.3s; font-size: 24px;
        }
        .slider-ctrl:hover { opacity: 1; background: rgba(255,255,255,0.1); border-radius: 50%; }
        .slider-ctrl.prev { left: 10px; }
        .slider-ctrl.next { right: 10px; }

        /* 卡片增强 */
        .news-card { 
            background: #fff; border-radius: 20px; overflow: hidden; 
            transition: all 0.4s ease; border: 1px solid #f0f0f0; 
            display: flex; flex-direction: column; height: 100%;
        }
        .news-card:hover { transform: translateY(-5px); box-shadow: 0 15px 30px rgba(0,0,0,0.05); }

        .download-container { background: #f4f4f4; border-radius: 32px; padding: 60px 24px; }
        .dl-button { 
            background: var(--tesla-black); color: white; width: 100%; max-width: 320px; height: 48px; 
            display: inline-flex; align-items: center; justify-content: center;
            border-radius: 24px; font-size: 15px; font-weight: 600; transition: 0.3s;
        }
        .dl-button:hover { background: #333; transform: scale(1.02); }

        .reveal { opacity: 0; transform: translateY(20px); transition: all 0.6s ease-out; }
        .reveal.visible { opacity: 1; transform: translateY(0); }

        #newsModal { display: none; position: fixed; inset: 0; z-index: 2000; background: #fff; overflow-y: auto; padding: 40px 20px; }
        #mobileNav { 
            position: fixed; top: 0; right: -100%; width: 100%; height: 100vh; 
            background: #fff; z-index: 1050; transition: 0.4s ease;
            display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 32px;
        }
        #mobileNav.open { right: 0; }

        /* 强制广告位不坍塌 */
        .ad-placeholder { min-height: 250px; background: #fafafa; border: 1px dashed #eee; display: flex; align-items: center; justify-content: center; color: #ccc; font-size: 12px; }
    </style>
</head>
<body>

    <nav>
        <div class="brand-container">
            <img src="https://raw.githubusercontent.com/jasonmartin201919/mcore-activator/main/logo02.png" class="brand-logo" alt="MCORE">
        </div>
        
        <div class="nav-links hidden md:flex">
            <a href="#">首页</a>
            <a href="#tech">技术探讨</a>
            <a href="#download">下载中心</a>
            <a href="#news">新闻动态</a>
            <a href="#about">关于我们</a>
        </div>

        <div class="md:hidden" id="menuBtn" onclick="toggleMobileNav()">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </div>
    </nav>

    <div id="mobileNav">
        <a href="#" onclick="toggleMobileNav()" class="text-2xl font-bold">首页</a>
        <a href="#tech" onclick="toggleMobileNav()" class="text-2xl font-bold">技术探讨</a>
        <a href="#download" onclick="toggleMobileNav()" class="text-2xl font-bold">下载中心</a>
        <a href="#news" onclick="toggleMobileNav()" class="text-2xl font-bold">新闻动态</a>
    </div>

    <section class="hero-slider" id="home">
        <div class="slider-ctrl prev" onclick="moveSlide(-1)">❮</div>
        <div class="slider-ctrl next" onclick="moveSlide(1)">❯</div>
        <div id="sliderContainer">
            <div class="slide active">
                <div class="slide-overlay"></div>
                <div class="slide-content">
                    <h1 id="loadingTitle">MCORE 资产管理</h1>
                    <p id="loadingSubtitle">正在加载最新视觉技术...</p>
                </div>
            </div>
        </div>
    </section>

    <section id="tech" class="max-w-7xl mx-auto px-6 py-24">
        <div class="flex flex-col items-center mb-16 reveal">
            <h2 class="text-3xl font-semibold mb-4">技术探讨</h2>
            <div class="h-1 w-12 bg-gray-200 mb-6"></div>
            <p class="text-gray-500 text-sm max-w-lg text-center">核心算法解析与本地隐私保护方案研究。</p>
        </div>
        <div id="techContainer" class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="p-8 border rounded-3xl text-gray-200">正在同步技术文档内容...</div>
            <div class="p-8 border rounded-3xl text-gray-200">正在同步技术文档内容...</div>
            <div class="p-8 border rounded-3xl text-gray-200">正在同步技术文档内容...</div>
        </div>
    </section>

    <section id="download" class="max-w-7xl mx-auto px-6 pb-24">
        <div class="download-container reveal">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
                <div class="text-center md:text-left space-y-6">
                    <h3 class="text-2xl font-bold">立即开启高效管理</h3>
                    <p class="text-gray-500 text-sm">
                        MCORE 始终坚持“本地处理”原则，所有比对算法均在您的机器端运行，无需上传云端。通过像素指纹验证，确保您的私人图像资产安全无忧。
                    </p>
                    <div class="pt-4">
                        <a id="mainDownloadBtn" href="#" class="dl-button">获取 MCORE 桌面客户端</a>
                        <p class="mt-4 text-xs text-gray-400">支持 Windows 10/11 · 本地环境运行</p>
                    </div>
                </div>
                <div class="flex flex-col items-center md:items-end">
                    <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100 flex flex-col items-center w-full max-w-[280px]">
                        <img src="https://raw.githubusercontent.com/jasonmartin201919/mcore-activator/main/assets/qrcode.png" class="w-32 h-32 mb-4" alt="QR">
                        <span class="text-sm font-bold">微信公众号：MCORE 科技</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="news" class="max-w-7xl mx-auto px-6 pb-24">
        <div class="flex flex-col items-center mb-16 reveal">
            <h2 class="text-3xl font-semibold mb-4">新闻动态</h2>
            <div class="h-1 w-12 bg-gray-200 mb-6"></div>
        </div>
        <div id="newsSectionContainer" class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="p-8 text-center text-gray-300">正在获取最新动态...</div>
        </div>
    </section>

    <footer class="py-12 border-t border-gray-50">
        <div class="max-w-7xl mx-auto px-6 flex flex-col items-center">
            <div class="flex gap-8 mb-8 text-[11px] font-bold text-gray-400 uppercase tracking-widest">
                <a href="#">Privacy</a>
                <a href="mailto:support@mcore.sbs">Contact</a>
            </div>
            <div class="text-[10px] text-gray-300 tracking-[0.2em]">MCORE TECHNOLOGY &copy; 2025-2026</div>
        </div>
    </footer>

    <div id="newsModal">
        <div class="max-w-3xl mx-auto">
            <button onclick="closeModal()" class="text-sm font-bold mb-10 block opacity-50">← 返回</button>
            <h2 id="modalTitle" class="text-3xl font-bold mb-6"></h2>
            <div id="modalContent" class="text-gray-700 leading-loose space-y-4"></div>
        </div>
    </div>

    <script>
        // 修改后的配置逻辑
        const CONFIG_URLS = [
            `https://cdn.jsdelivr.net/gh/jasonmartin201919/mcore-activator@main/config.json`,
            `https://raw.githubusercontent.com/jasonmartin201919/mcore-activator/main/config.json`
        ];

        let globalTechData = [];
        let globalNewsData = [];
        let slideIdx = 0;

        function toggleMobileNav() {
            const nav = document.getElementById('mobileNav');
            nav.classList.toggle('open');
        }

        async function fetchConfig() {
            for (const url of CONFIG_URLS) {
                try {
                    const res = await fetch(`${url}?v=${new Date().getTime()}`, { cache: "no-store" });
                    if (!res.ok) continue;
                    const data = await res.json();
                    return data.ads || data; // 兼容不同格式
                } catch (e) {
                    console.warn("Failed to fetch from:", url);
                }
            }
            throw new Error("All sources failed");
        }

        async function init() {
            try {
                const ads = await fetchConfig();
                
                // 1. 渲染轮播
                const carouselItems = ads.carousel || [];
                if(carouselItems.length > 0) {
                    renderCarousel(carouselItems);
                }

                // 2. 渲染下载链接
                if(ads.download_url) {
                    document.getElementById('mainDownloadBtn').href = ads.download_url;
                }

                // 3. 渲染技术卡片
                globalTechData = ads.jishu || [];
                renderCards('techContainer', globalTechData, 'tech');

                // 4. 渲染新闻卡片
                globalNewsData = ads.wenzhang || [];
                renderCards('newsSectionContainer', globalNewsData, 'news');

            } catch (err) {
                console.error("Init Error:", err);
                document.getElementById('loadingSubtitle').innerText = "当前由于网络原因，请手动刷新重试";
            }
        }

        function renderCarousel(items) {
            const container = document.getElementById('sliderContainer');
            container.innerHTML = items.map((item, i) => `
                <div class="slide ${i === 0 ? 'active' : ''}">
                    <div class="slide-overlay"></div>
                    <img src="${item.media || item.image}" class="absolute inset-0 w-full h-full object-cover">
                    <div class="slide-content">
                        <h1>${item.title}</h1>
                        <p>${item.subtitle || ''}</p>
                    </div>
                </div>
            `).join('');
        }

        function renderCards(containerId, list, type) {
            const container = document.getElementById(containerId);
            if(!list.length) return;
            container.innerHTML = list.map((item, i) => `
                <div onclick="openModal('${type}', ${i})" class="news-card cursor-pointer group">
                    <div class="h-48 bg-gray-100 overflow-hidden">
                        <img src="${item.image || 'https://via.placeholder.com/400x300'}" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                    </div>
                    <div class="p-6">
                        <span class="text-[10px] text-gray-400 uppercase tracking-widest">${item.date || '2026'}</span>
                        <h4 class="text-lg font-bold mt-2 mb-2 line-clamp-1">${item.title}</h4>
                        <p class="text-gray-400 text-xs line-clamp-2">${item.summary || ''}</p>
                    </div>
                </div>
            `).join('');
        }

        function openModal(type, i) {
            const item = (type === 'tech') ? globalTechData[i] : globalNewsData[i];
            document.getElementById('modalTitle').innerText = item.title;
            document.getElementById('modalContent').innerHTML = (item.content || item.summary).split('\n').map(p => `<p>${p}</p>`).join('');
            document.getElementById('newsModal').style.display = 'block';
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            document.getElementById('newsModal').style.display = 'none';
            document.body.style.overflow = 'auto';
        }

        function moveSlide(step) {
            const slides = document.querySelectorAll('.slide');
            if(!slides.length) return;
            slides[slideIdx].classList.remove('active');
            slideIdx = (slideIdx + step + slides.length) % slides.length;
            slides[slideIdx].classList.add('active');
        }

        window.onload = () => {
            init();
            setInterval(() => moveSlide(1), 5000);
            
            const observer = new IntersectionObserver(entries => {
                entries.forEach(e => { if(e.isIntersecting) e.target.classList.add('visible'); });
            });
            document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
        };
    </script>
</body>
</html>
